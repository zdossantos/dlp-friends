includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    stubFiles:
        - stubs/reverb.stub

    parallel:
        maximumNumberOfProcesses: 1

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7
